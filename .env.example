# Copy to .env.local and fill in. Never commit .env.local.
# src/env.ts parses these with zod at boot and fails fast if any are missing.

# --- Database -----------------------------------------------------------
# Local dev runs against the Docker Compose Postgres (`npm run db:up`).
# Deployed environments point at Neon (use the -pooler host).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freight_dev

# Separate database for the test suite. Required only when running tests.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freight_test

# --- Auth.js ------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=
# Only needed when the deployment URL can't be inferred (local dev is fine without it).
# AUTH_URL=http://localhost:3000

# Resend API key, used for magic-link sign-in emails.
AUTH_RESEND_KEY=
# Must be an address on a domain verified in Resend. The exception is
# onboarding@resend.dev, Resend's shared test sender, which needs no DNS setup
# but only delivers to the Resend account owner's own address — fine for
# testing the sign-in flow, useless for real users.
AUTH_EMAIL_FROM=onboarding@resend.dev

# --- FMCSA --------------------------------------------------------------
# QCMobile webKey for carrier lookups. Register an application at
# https://mobile.fmcsa.dot.gov/QCDevsite/docs/getStarted with a login.gov
# account; the key appears under "My WebKeys".
#
# Optional. Without it the app still runs — the vetting screen shows a setup
# notice instead of failing a lookup it cannot make.
FMCSA_WEB_KEY=

# Points the FMCSA client somewhere other than the real API. Only for
# exercising the vetting flow against a stub; leave unset otherwise.
# FMCSA_BASE_URL=http://localhost:9917
